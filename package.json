{
  "name": "tauri-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "tauri": "node scripts/tauri.mjs",
    "build:llama": "node scripts/build-llama-server.mjs",
    "build:whisper": "node scripts/build-whisper-server.mjs",
    "build:applefm": "bash scripts/build-applefm.sh",
    "build:imageplayground": "bash scripts/build-imageplayground.sh",
    "build:bonsai": "node scripts/build-bonsai-engine.mjs",
    "bonsai:publish": "bash scripts/publish-bonsai-engine.sh",
    "pc:push": "bash scripts/sync-pc.sh push",
    "pc:pull": "bash scripts/sync-pc.sh pull",
    "pc:status": "bash scripts/sync-pc.sh status",
    "synchub": "bash tools/synchub/run.sh --open",
    "security:audit": "bash scripts/security-audit.sh",
    "security:sbom": "bash scripts/security-sbom.sh",
    "setup:updater": "node scripts/setup-updater.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test scripts/test-*.mjs",
    "build:mac": "bash scripts/build-macos.sh",
    "dev:pro": "echo 'Obsol\u00e8te en 0.2 : la feature pro est compil\u00e9e par d\u00e9faut, utilisez npm run tauri dev' && exit 1",
    "build:pro": "echo 'Obsol\u00e8te en 0.2 : la feature pro est compil\u00e9e par d\u00e9faut, utilisez npm run tauri build' && exit 1",
    "build:mac:pro": "echo 'Obsol\u00e8te en 0.2 : utilisez npm run build:mac' && exit 1",
    "build:all": "bash scripts/build-all.sh",
    "build:server": "bash scripts/build-all.sh server",
    "apps:package": "node scripts/package-apps.mjs",
    "apps:sign": "node scripts/repo-sign.mjs dist/apps/index.json",
    "apps:publish": "bash scripts/publish-apps.sh",
    "apps:install-local": "node scripts/install-apps-local.mjs",
    "apps:reinstall": "node scripts/install-apps-local.mjs --every",
    "deploy:pi": "bash scripts/deploy-pi.sh",
    "license:keygen": "node scripts/license-keygen.mjs",
    "license:issue": "node scripts/license-issue.mjs",
    "vendor:build": "node scripts/build-vendor.mjs",
    "build:mac:signed": "bash scripts/build-macos-signed.sh",
    "eval:orch": "node scripts/orch-eval.mjs",
    "bench": "node scripts/lumen-bench.mjs",
    "bench:gate": "node scripts/lumen-bench.mjs --suites coverage,prompts,routers --gate",
    "build:frontend": "node scripts/build-frontend.mjs",
    "eval:docs": "node scripts/doc-eval.mjs",
    "eval:code": "node scripts/code-eval.mjs",
    "source:plan": "python3 scripts/export-source.py --dry-run",
    "source:sync": "python3 scripts/export-source.py",
    "licenses:collect": "node scripts/collect-npm-licenses.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.7",
    "maplibre-gl": "^6.11.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "three": "^0.184.0"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  }
}
